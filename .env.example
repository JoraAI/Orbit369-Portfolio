# ------------------------------------------------------------------
# Email — Resend (https://resend.com)
# Contact form submissions are delivered to CONTACT_TO_EMAIL via Resend.
# Copy this file to .env.local and fill in the values.
# ------------------------------------------------------------------

# API key — create one at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Inbox that receives contact form submissions
CONTACT_TO_EMAIL=orbit369media@gmail.com

# "From" label on the emails Resend sends — must be on a domain you've
# verified in Resend (https://resend.com/domains).
#
# IMPORTANT: you do NOT need a real mailbox at this address. It is only
# the sender name/label shown on the email; deliveries go to
# CONTACT_TO_EMAIL (your Gmail) above. Any address on your verified
# domain works — hello@, contact@, no-reply@, etc.
CONTACT_FROM_EMAIL=hello@orbit369media.com
